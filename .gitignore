# Credentials - never commit these.
# Anchored to the repository root and named explicitly. A blanket `*.json` rule
# used to live here; besides credentials it also silently ignored
# src/aptos/data/ and would hide any JSON asset shipped inside the package.
/*.json
/credentials/
*-service-account*.json
client_secret*.json

# Data and model artefacts: large, and reproducible from the pipeline.
# The leading slash matters. Without it, `data/` matches a directory named
# `data` at ANY depth - which is exactly how src/aptos/data/ came to be ignored.
/data/
/models/
/mlruns/
/outputs/
*.pt
*.pth

# Raw and intermediate images.
*.jpeg
*.tif

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated images and tables stay out of version control...
*.png
*.jpg
*.csv

# ...except the report outputs, which are delivered work.
!reports/figures/*.png
!reports/*.csv
